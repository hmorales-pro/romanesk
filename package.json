{
  "name": "romanesk",
  "private": true,
  "version": "0.3.0",
  "description": "Romanesk monorepo — local-first writing environment for fictional universes.",
  "license": "LicenseRef-Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmorales-pro/romanesk.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @romanesk/desktop dev",
    "build": "pnpm --filter @romanesk/desktop build",
    "tauri": "pnpm --filter @romanesk/desktop tauri",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @romanesk/desktop exec tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "linkify-it": "^5.0.2",
      "js-yaml": "^4.3.1",
      "postcss": "^8.5.18",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@5": "^5.0.8",
      "nanoid": "^3.3.18",
      "markdown-it": "^14.2.0",
      "@babel/core": "^7.29.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2",
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
